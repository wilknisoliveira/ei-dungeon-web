{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "ei-dungeon-web": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss"
                }
            },
            "i18n": {
                "sourceLocale": "en",
                "locales": {
                    "pt-BR": {
                        "translation": "src/i18n/messages.pt-BR.xlf",
                        "baseHref": "/pt-BR/"
                    },
                    "es": {
                        "translation": "src/i18n/messages.es.xlf",
                        "baseHref": "/es/"
                    }
                }
            },
            "root": "",
            "sourceRoot": "src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular/build:application",
                    "options": {
                        "outputPath": "dist/ei-dungeon-web",
                        "index": "src/index.html",
                        "browser": "src/main.ts",
                        "server": "src/main.server.ts",
                        "outputMode": "static",
                        "polyfills": ["zone.js", "@angular/localize/init"],
                        "tsConfig": "tsconfig.app.json",
                        "inlineStyleLanguage": "scss",
                        "assets": ["src/favicon.ico", "src/assets"],
                        "styles": ["src/styles.scss"],
                        "scripts": [],
                        "i18nMissingTranslation": "error"
                    },
                    "configurations": {
                        "production": {
                            "localize": true,
                            "budgets": [
                                {
                                    "type": "initial",
                                    "maximumWarning": "500kb",
                                    "maximumError": "1mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "6kb",
                                    "maximumError": "10kb"
                                }
                            ],
                            "outputHashing": "all"
                        },
                        "development": {
                            "optimization": false,
                            "extractLicenses": false,
                            "sourceMap": true
                        },
                        "en": {
                            "localize": ["en"]
                        },
                        "pt-BR": {
                            "localize": ["pt-BR"]
                        },
                        "es": {
                            "localize": ["es"]
                        }
                    },
                    "defaultConfiguration": "production"
                },
                "serve": {
                    "builder": "@angular/build:dev-server",
                    "configurations": {
                        "production": {
                            "buildTarget": "ei-dungeon-web:build:production"
                        },
                        "development": {
                            "buildTarget": "ei-dungeon-web:build:development"
                        },
                        "en": {
                            "buildTarget": "ei-dungeon-web:build:development,en"
                        },
                        "pt-BR": {
                            "buildTarget": "ei-dungeon-web:build:development,pt-BR"
                        },
                        "es": {
                            "buildTarget": "ei-dungeon-web:build:development,es"
                        }
                    },
                    "defaultConfiguration": "development"
                },
                "test": {
                    "builder": "@angular/build:karma",
                    "options": {
                        "polyfills": ["zone.js", "zone.js/testing"],
                        "tsConfig": "tsconfig.spec.json",
                        "inlineStyleLanguage": "scss",
                        "assets": ["src/favicon.ico", "src/assets"],
                        "styles": [
                            "@angular/material/prebuilt-themes/azure-blue.css",
                            "src/styles.scss"
                        ],
                        "scripts": []
                    }
                },
                "extract-i18n": {
                    "builder": "@angular/build:extract-i18n",
                    "options": {
                        "outputPath": "src/i18n",
                        "format": "xlf"
                    }
                }
            }
        }
    },
    "cli": {
        "analytics": false
    }
}
